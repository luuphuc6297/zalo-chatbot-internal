{
  "name": "@thomhouse/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/gen-seed-data.mjs && wrangler dev --local --test-scheduled",
    "db:migrate:local": "wrangler d1 migrations apply thomhouse-main --local",
    "deploy": "node scripts/gen-seed-data.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/gen-seed-data.mjs && vitest run",
    "gen:seed": "node scripts/gen-seed-data.mjs"
  },
  "dependencies": {
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0",
    "@cloudflare/vitest-plugin": "1.6.0"
  }
}
