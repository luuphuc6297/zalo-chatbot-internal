# Copy to apps/runner/.env (gitignored). Placeholders only; environment variables win over this file.
SERVER_URL=http://127.0.0.1:8787
# Leave RUNNER_TOKEN empty to read it from the macOS Keychain item named by RUNNER_TOKEN_KEYCHAIN_SERVICE.
RUNNER_TOKEN=dev-runner-token-change-me
RUNNER_TOKEN_KEYCHAIN_SERVICE=thomhouse-runner
RUNNER_ID=mac-studio-1
# Pool accounts, shared sessions dir and per-conversation workdirs; tests point this at a temp dir.
THOMHOUSE_BOT_HOME=~/.thomhouse-bot
MAX_CONCURRENCY=3
CLAUDE_TIMEOUT_S=60
HEARTBEAT_S=20
STATUS_EVERY_S=60
THOMHOUSE_CLAUDE_MODEL=claude-opus-5-5
THOMHOUSE_CLAUDE_EFFORT=low
# Two-bot rooms (docs/contracts.md 14.8). claude = one claude -p call per job (default); rooms = two bots in a
# room of the rooms platform. Run `python3 -m runner.main rooms-setup` before the platform starts.
THOMHOUSE_DRAFT_ENGINE=claude
