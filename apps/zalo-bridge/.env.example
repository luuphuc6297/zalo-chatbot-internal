# Copy to apps/zalo-bridge/.env (gitignored), or let scripts/start_local.sh write it. Placeholders only.
SERVER_URL=http://127.0.0.1:8787
# Same value as RUNNER_TOKEN in apps/server/.dev.vars.
RUNNER_TOKEN=runner-token-change-me
BRIDGE_ID=mac-bridge-1
# Same value as ZALO_PERSONAL_WEBHOOK_SECRET in apps/server/.dev.vars. Passed to `zalo-agent listen` as env.
ZALO_PERSONAL_WEBHOOK_SECRET=webhook-secret-change-me
# Default: <repo>/tools/zalo-agent/node_modules/.bin/zalo-agent when installed, else zalo-agent on PATH.
ZALO_AGENT_BIN=
# Optional: exact numeric Zalo account id when more than one account is registered in zalo-agent.
ZALO_ACCOUNT=
SEND_MIN_INTERVAL_S=2
SEND_JITTER_S=1
SEND_TIMEOUT_S=30
LOGIN_PAUSE_S=60
# Journal of sent rows: $THOMHOUSE_BOT_HOME/bridge (default ~/.thomhouse-bot/bridge).
THOMHOUSE_BOT_HOME=~/.thomhouse-bot
